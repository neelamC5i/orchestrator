# Server
POSTGRES_USER=orchestrator
POSTGRES_PASSWORD=orchestrator_secret
POSTGRES_DB=orchestrator
REDIS_URL=redis://localhost:6379
DATABASE_URL=postgresql+asyncpg://orchestrator:orchestrator_secret@localhost:5432/orchestrator

# Ollama (local)
OLLAMA_BASE_URL=http://localhost:11434

# Optional cloud providers (fill only what you have)
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
GROQ_API_KEY=
HF_TOKEN=
FRED_API_KEY=

# Storage
SLM_STORE_PATH=./slm_store
CORPUS_STORE_PATH=./corpus_store

# Frontend (leave NEXT_PUBLIC_API_URL empty to proxy /api through Next.js — avoids CORS)
NEXT_PUBLIC_API_URL=
# API_PROXY_URL=http://backend:8000   # set in docker-compose for container-to-container proxy

# Authentication (backend)
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000
AUTH_SECRET_KEY=change-this-to-a-random-secret-in-production
AUTH_USERNAME=admin
AUTH_PASSWORD=orchestrator
